+// An agent's own picture, when another mod gives it one (Pokémon herd: its Pokémon), in shared
+// state "agent-icons": { <terminal address>: <image path in the home folder> }. Else its program's.
+function agentIcon(address, p, size, color) {
+  const own = shared("agent-icons")?.[address];
+  return own ? image(own).w(size + 2).h(size + 2).flex_none() : icon(p, size, color);
+}
