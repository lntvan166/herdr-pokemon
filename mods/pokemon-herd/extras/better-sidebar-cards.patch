+                    .child(div().h_full().w(`${Math.round(Math.max(0, Math.min(1, card.progress)) * 100)}%`).bg(t.accent)),
+                )
+                .child(div().flex_none().text_size(TEXT.caption).text_color(t.dim).child(card.note ?? "")),
+            ),
+          )
+          .when(!bar && Boolean(card.note), (el) =>
+            el.child(div().truncate().text_size(TEXT.caption).text_color(t.dim).child(card.note)),
+          ),
