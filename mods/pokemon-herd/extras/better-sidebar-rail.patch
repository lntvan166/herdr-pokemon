+  // On the rail: its Pokémon (shared "agent-icons", from Pokémon herd), a dot in its status
+  // colour on the corner (pulsing while it needs you); without one, its status as before.
+  railIcon(t, a, size = 22) {
+    const own = shared("agent-icons")?.[a.address];
+    if (!own) return this.status(t, a, true);
+    return div()
+      .relative()
+      .size(size)
+      .flex_none()
+      .child(image(own).absolute().left(0).top(0).size(size))
+      .child(
+        div()
+          .absolute()
+          .right(-1)
+          .bottom(-1)
+          .size(8)
+          .rounded_full()
+          .border_1()
